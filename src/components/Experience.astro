<style>
    .experience-deck {
        max-width: 56rem;
        margin-inline: auto;
        padding-inline: 1rem;
    }

    /* Default (no-JS / reduced motion): normal vertical stack */
    .deck-stack {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }
    .deck-card { width: 90%; }

    .deck-controls {
        display: none;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        margin-top: 2.5rem;
        font-size: 0.85rem;
        opacity: 0.7;
    }
    .deck-counter {
        font-weight: 600;
        background-color: hsl(var(--b2));
        border-radius: 9999px;
        padding: 0.15rem 0.6rem;
    }

    /* Enhanced deck (JS on, motion allowed) */
    [data-deck-enhanced] .deck-stack {
        display: block;
        position: relative;
        overflow: hidden;
        padding-top: 40px; /* room for the top peek of cards behind */
        padding-bottom: 12px; /* room for front card shadow */
    }
    [data-deck-enhanced] .deck-card {
        position: absolute;
        top: 40px;
        left: 50%;
        width: 90%;
        transform: translateX(-50%);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease, filter 0.45s ease;
        will-change: transform, opacity;
    }

    /* Front card: full, on top. Fills the fixed container so it always
       covers whatever is behind it — no spill even when this card is short,
       and container height stays constant so content below never jumps. */
    [data-deck-enhanced] .deck-card[data-depth="0"] {
        transform: translateX(-50%) translateY(0) scale(1);
        opacity: 1;
        z-index: 3;
        cursor: pointer;
        filter: none;
    }
    [data-deck-enhanced] .deck-card[data-depth="0"] > .card {
        min-height: var(--deck-card-h, auto);
    }
    /* Cards behind peek UP from the top; the opaque full-height front card
       covers their bodies, so only their top sliver shows. */
    [data-deck-enhanced] .deck-card[data-depth="1"] {
        transform: translateX(-50%) translateY(-20px) scale(0.96);
        opacity: 1;
        z-index: 2;
        filter: brightness(0.96);
    }
    [data-deck-enhanced] .deck-card[data-depth="2"] {
        transform: translateX(-50%) translateY(-40px) scale(0.92);
        opacity: 1;
        z-index: 1;
        filter: brightness(0.92);
    }
    /* Behind cards are non-interactive; container overflow hides their lower part */
    [data-deck-enhanced] .deck-card:not([data-depth="0"]) {
        pointer-events: none;
    }

    [data-deck-enhanced] .deck-controls { display: flex; }

    @media (prefers-reduced-motion: reduce) {
        [data-deck-enhanced] .deck-stack {
            display: flex !important;
            height: auto !important;
        }
        [data-deck-enhanced] .deck-card {
            position: static !important;
            transform: none !important;
            opacity: 1 !important;
            filter: none !important;
            pointer-events: auto !important;
        }
        [data-deck-enhanced] .deck-controls { display: none !important; }
    }
</style>

<script>
    function initDeck(root: HTMLElement) {
        const stack = root.querySelector<HTMLElement>("[data-deck-stack]");
        if (!stack) return;
        const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-deck-card]"));
        if (cards.length < 2) return;

        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) return;

        root.setAttribute("data-deck-enhanced", "");

        const counter = root.querySelector<HTMLElement>("[data-deck-counter]");
        let order = cards.map((_, i) => i); // order[0] = front

        function sizeStack() {
            // Fixed height = TALLEST card + top peek room, computed once.
            // Constant height => cycling never resizes the container, so content
            // below Experience doesn't jump. The front card is given this same
            // height via --deck-card-h so it always fully covers the cards behind.
            let maxH = 0;
            cards.forEach((c) => {
                c.style.removeProperty("min-height"); // measure natural height
            });
            cards.forEach((c) => { maxH = Math.max(maxH, c.querySelector<HTMLElement>(".card")!.offsetHeight); });
            stack.style.height = `${maxH + 40 + 12}px`;
            stack.style.setProperty("--deck-card-h", `${maxH}px`);
        }

        function render() {
            order.forEach((cardIdx, depth) => {
                const card = cards[cardIdx];
                card.setAttribute("data-depth", String(depth));
                const isFront = depth === 0;
                card.setAttribute("aria-hidden", isFront ? "false" : "true");
                card.querySelectorAll<HTMLElement>("a, button").forEach((el) => {
                    isFront ? el.removeAttribute("tabindex") : el.setAttribute("tabindex", "-1");
                });
                card.setAttribute("tabindex", isFront ? "0" : "-1");
                card.setAttribute("role", "group");
            });
            if (counter) counter.textContent = `${order[0] + 1} / ${cards.length}`;
        }

        function cycle() {
            const front = order.shift();
            if (front !== undefined) order.push(front);
            render();
        }

        cards.forEach((card) => {
            card.addEventListener("click", (e) => {
                if (card.getAttribute("data-depth") !== "0") return;
                const target = e.target as HTMLElement;
                if (target.closest("a")) return; // let real links through
                cycle();
            });
            card.addEventListener("keydown", (e) => {
                if (card.getAttribute("data-depth") !== "0") return;
                if (e.key === "Enter" || e.key === " " || e.key === "ArrowDown") {
                    e.preventDefault();
                    cycle();
                }
            });
        });

        render();
        requestAnimationFrame(sizeStack);
        window.addEventListener("load", sizeStack);
        window.addEventListener("resize", sizeStack);
    }

    document.querySelectorAll<HTMLElement>("[data-deck]").forEach(initDeck);
</script>
