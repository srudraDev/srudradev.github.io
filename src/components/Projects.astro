<style>
    /* Base layout: works even before JS loads. Without JS this is a horizontal scroll row. */
    .projects-coverflow {
        position: relative;
        margin-inline: auto;
        max-width: 72rem;
        padding-inline: 4.5rem; /* room for nav buttons + offset side cards */
    }

    .cf-viewport {
        overflow: hidden;
        perspective: 1600px;
    }

    .cf-track {
        list-style: none;
        margin: 0;
        padding: 2rem 0;
        display: flex;
        align-items: stretch;
        justify-content: flex-start;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .cf-slide {
        flex: 0 0 100%;
        max-width: 24rem;
        margin-inline: auto;
        transition: transform 0.5s ease, opacity 0.5s ease, filter 0.5s ease;
        transform-origin: center center;
    }

    .cf-slide > .card {
        height: 100%;
    }

    /* Coverflow states applied by JS via data-pos on each slide */
    [data-cf-enhanced] .cf-slide {
        opacity: 0;
        transform: scale(0.7) rotateY(0deg);
        pointer-events: none;
    }
    [data-cf-enhanced] .cf-slide[data-pos="center"] {
        opacity: 1;
        filter: none;
        transform: scale(1) rotateY(0deg);
        z-index: 5;
        pointer-events: auto;
    }
    [data-cf-enhanced] .cf-slide[data-pos="left"] {
        opacity: 0.4;
        filter: blur(1px);
        transform: translateX(82%) scale(0.76) rotateY(34deg);
        z-index: 2;
    }
    [data-cf-enhanced] .cf-slide[data-pos="right"] {
        opacity: 0.4;
        filter: blur(1px);
        transform: translateX(-82%) scale(0.76) rotateY(-34deg);
        z-index: 2;
    }
    [data-cf-enhanced] .cf-slide[data-pos="far"] {
        opacity: 0;
        transform: scale(0.6);
        z-index: 1;
        pointer-events: none;
    }

    /* Center card must be fully opaque so nothing behind bleeds through */
    [data-cf-enhanced] .cf-slide[data-pos="center"] > .card {
        background-color: hsl(var(--b1));
    }

    /* When enhanced, stack slides so transforms overlap in the same space */
    [data-cf-enhanced] .cf-track {
        display: grid;
        grid-template-areas: "stack";
        justify-content: center;
    }
    [data-cf-enhanced] .cf-slide {
        grid-area: stack;
        flex: none;
        width: 100%;
    }

    .cf-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        display: none; /* shown only when enhanced */
    }
    .cf-prev { left: 0; }
    .cf-next { right: 0; }
    [data-cf-enhanced] .cf-nav { display: inline-flex; }

    .cf-dots {
        display: none;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    [data-cf-enhanced] .cf-dots { display: flex; }

    .cf-dot {
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 9999px;
        background-color: hsl(var(--bc) / 0.3);
        transition: background-color 0.3s ease, transform 0.3s ease;
        cursor: pointer;
        border: none;
        padding: 0;
    }
    .cf-dot[aria-selected="true"] {
        background-color: hsl(var(--p));
        transform: scale(1.3);
    }

    /* Fallback for no-JS or reduced motion: simple responsive grid like before */
    @media (prefers-reduced-motion: reduce) {
        .cf-viewport { overflow: visible; perspective: none; }
        .cf-track {
            display: grid !important;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: 1.5rem;
            transform: none !important;
        }
        .cf-slide {
            opacity: 1 !important;
            filter: none !important;
            transform: none !important;
            pointer-events: auto !important;
            max-width: none;
        }
        .cf-nav, .cf-dots { display: none !important; }
    }
    @media (prefers-reduced-motion: reduce) and (min-width: 768px) {
        .cf-track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (prefers-reduced-motion: reduce) and (min-width: 1024px) {
        .cf-track { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
</style>

<script>
    type Pos = "center" | "left" | "right" | "far";

    function initCoverflow(root: HTMLElement) {
        const track = root.querySelector<HTMLElement>("[data-cf-track]");
        const slides = Array.from(root.querySelectorAll<HTMLElement>(".cf-slide"));
        const prevBtn = root.querySelector<HTMLButtonElement>("[data-cf-prev]");
        const nextBtn = root.querySelector<HTMLButtonElement>("[data-cf-next]");
        const dotsWrap = root.querySelector<HTMLElement>("[data-cf-dots]");
        if (!track || slides.length === 0 || !dotsWrap) return;

        // Respect reduced motion: leave the static grid fallback in place, no enhancement.
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) return;

        root.setAttribute("data-cf-enhanced", "");

        let index = 0;
        const count = slides.length;
        let autoplayTimer: number | undefined;
        const AUTOPLAY_MS = 5000;

        // Build dots
        const dots: HTMLButtonElement[] = slides.map((_, i) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.className = "cf-dot";
            dot.setAttribute("role", "tab");
            dot.setAttribute("aria-label", `Go to project ${i + 1}`);
            dot.addEventListener("click", () => {
                goTo(i);
                restartAutoplay();
            });
            dotsWrap.appendChild(dot);
            return dot;
        });

        function render() {
            slides.forEach((slide, i) => {
                let pos: Pos = "far";
                const diff = (i - index + count) % count;
                if (diff === 0) pos = "center";
                else if (diff === 1) pos = "right";
                else if (diff === count - 1) pos = "left";
                slide.setAttribute("data-pos", pos);
                slide.setAttribute("aria-hidden", pos === "center" ? "false" : "true");
                // keep offscreen slides out of tab order
                slide.querySelectorAll<HTMLElement>("a, button").forEach((el) => {
                    if (pos === "center") el.removeAttribute("tabindex");
                    else el.setAttribute("tabindex", "-1");
                });
            });
            dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === index ? "true" : "false"));
        }

        function goTo(i: number) {
            index = (i + count) % count;
            render();
        }
        function next() { goTo(index + 1); }
        function prev() { goTo(index - 1); }

        function startAutoplay() {
            stopAutoplay();
            autoplayTimer = window.setInterval(next, AUTOPLAY_MS);
        }
        function stopAutoplay() {
            if (autoplayTimer) window.clearInterval(autoplayTimer);
            autoplayTimer = undefined;
        }
        function restartAutoplay() {
            startAutoplay();
        }

        nextBtn?.addEventListener("click", () => { next(); restartAutoplay(); });
        prevBtn?.addEventListener("click", () => { prev(); restartAutoplay(); });

        // Keyboard navigation when carousel is focused/hovered
        root.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") { next(); restartAutoplay(); }
            else if (e.key === "ArrowLeft") { prev(); restartAutoplay(); }
        });

        // Pause autoplay on hover/focus
        root.addEventListener("mouseenter", stopAutoplay);
        root.addEventListener("mouseleave", startAutoplay);
        root.addEventListener("focusin", stopAutoplay);
        root.addEventListener("focusout", startAutoplay);

        // Touch swipe
        let startX = 0;
        let swiping = false;
        root.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX;
            swiping = true;
            stopAutoplay();
        }, { passive: true });
        root.addEventListener("touchend", (e) => {
            if (!swiping) return;
            swiping = false;
            const dx = e.changedTouches[0].clientX - startX;
            if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); }
            startAutoplay();
        });

        // Pause when tab is hidden
        document.addEventListener("visibilitychange", () => {
            document.hidden ? stopAutoplay() : startAutoplay();
        });

        // Make the carousel focusable for keyboard users
        root.setAttribute("tabindex", "0");

        render();
        startAutoplay();
    }

    document.querySelectorAll<HTMLElement>("[data-coverflow]").forEach(initCoverflow);
</script>
